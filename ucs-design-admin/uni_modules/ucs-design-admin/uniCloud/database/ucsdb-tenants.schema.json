{
  "bsonType": "object",
  "description": "租户",
  "required": [
    "tenant_no",
    "name",
    "type",
    "enabled"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "文档 ID"
    },
    "tenant_no": {
      "description": "五位租户号，平台租户固定为 00000",
      "bsonType": "string"
    },
    "name": {
      "description": "租户名称",
      "bsonType": "string"
    },
    "system_name": {
      "description": "租户系统名称，留空时使用平台默认名称",
      "bsonType": "string"
    },
    "system_logo": {
      "description": "租户系统 Logo 的云存储文件 ID，留空时使用平台默认 Logo",
      "bsonType": "string"
    },
    "theme_color": {
      "description": "租户主题色的十六进制颜色值，留空时使用平台默认主题",
      "bsonType": "string"
    },
    "type": {
      "description": "租户类型，platform 为平台租户，enterprise 为企业租户",
      "bsonType": "string",
      "enum": [
        "platform",
        "enterprise"
      ]
    },
    "enabled": {
      "description": "租户是否启用",
      "bsonType": "bool"
    },
    "expires_at": {
      "description": "租户到期时间，含当天，存储北京时间次日零点的毫秒时间戳。未设置表示长期有效。",
      "bsonType": "timestamp"
    },
    "system_mobile_revision": {
      "description": "系统用户手机号写入版本号，用于串行处理同一租户内的手机号修改",
      "bsonType": "int"
    },
    "product_package_ids": {
      "description": "已分配给租户的产品包文档 ID 列表",
      "bsonType": "array",
      "items": { "bsonType": "string", "foreignKey": "ucsdb-product-packages._id" }
    },
    "create_id": {
      "description": "创建人账号 ID",
      "bsonType": "string"
    },
    "create_name": {
      "description": "创建人姓名",
      "bsonType": "string"
    },
    "create_date": {
      "description": "创建时间",
      "bsonType": "timestamp"
    },
    "update_id": {
      "description": "最后更新人账号 ID",
      "bsonType": "string"
    },
    "update_name": {
      "description": "最后更新人姓名",
      "bsonType": "string"
    },
    "update_date": {
      "description": "最后更新时间",
      "bsonType": "timestamp"
    }
  }
}
