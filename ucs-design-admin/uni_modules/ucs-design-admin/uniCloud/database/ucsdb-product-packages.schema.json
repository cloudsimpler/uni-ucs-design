{
  "bsonType": "object",
  "description": "租户产品包",
  "required": [
    "name",
    "menu_ids",
    "permission_ids"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "文档 ID"
    },
    "name": {
      "description": "租户产品包名称",
      "bsonType": "string"
    },
    "remark": {
      "bsonType": "string",
      "maxLength": 500,
      "description": "产品包备注"
    },
    "menu_ids": {
      "description": "产品包包含的产品功能页面标识列表",
      "bsonType": "array",
      "items": {
        "bsonType": "string"
      }
    },
    "permission_ids": {
      "description": "产品包包含的操作权限标识列表",
      "bsonType": "array",
      "items": {
        "bsonType": "string"
      }
    },
    "create_id": {
      "description": "创建人账号 ID",
      "bsonType": "string"
    },
    "create_name": {
      "description": "创建人姓名",
      "bsonType": "string"
    },
    "create_date": {
      "description": "创建时间",
      "bsonType": "timestamp"
    },
    "update_id": {
      "description": "最后更新人账号 ID",
      "bsonType": "string"
    },
    "update_name": {
      "description": "最后更新人姓名",
      "bsonType": "string"
    },
    "update_date": {
      "description": "最后更新时间",
      "bsonType": "timestamp"
    }
  }
}
