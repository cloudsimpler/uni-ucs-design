{
  "bsonType": "object",
  "description": "素材表，记录文件信息和上传状态",
  "required": [
    "name",
    "state",
    "cloud_path"
  ],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "width": { "bsonType": "int", "description": "图片宽度，单位像素", "minimum": 1, "maximum": 1000000 },
    "height": { "bsonType": "int", "description": "图片高度，单位像素", "minimum": 1, "maximum": 1000000 },
    "cover_file_id": {
      "bsonType": "string",
      "description": "上传视频时自动截取的封面文件标识；无封面时为空"
    },
    "name": {
      "bsonType": "string",
      "description": "素材名称"
    },
    "file_id": {
      "bsonType": "string",
      "description": "云存储永久文件标识，不保存临时访问地址"
    },
    "cloud_path": {
      "bsonType": "string",
      "description": "服务端生成的上传路径"
    },
    "group_id": {
      "bsonType": "string",
      "description": "分组 ID，空字符串为未分组"
    },
    "type": {
      "bsonType": "string",
      "description": "素材类型，image 为图片、video 为视频、audio 为音频、document 为文档"
    },
    "mime": {
      "bsonType": "string",
      "description": "文件 MIME 类型"
    },
    "ext": {
      "bsonType": "string",
      "description": "文件扩展名"
    },
    "state": {
      "bsonType": "string",
      "description": "素材上传状态，uploading 为上传中，ready 为可用"
    },
    "size": {
      "bsonType": "long",
      "description": "文件字节数"
    },
    "tenant_id": {
      "bsonType": "string",
      "description": "所属租户 ID，引用租户表的 _id"
    },
    "create_id": {
      "bsonType": "string",
      "description": "上传人 ID"
    },
    "create_name": {
      "bsonType": "string",
      "description": "创建人姓名"
    },
    "create_date": {
      "description": "创建时间",
      "bsonType": "timestamp"
    },
    "update_id": {
      "bsonType": "string",
      "description": "最后修改人账号 ID"
    },
    "update_name": {
      "bsonType": "string",
      "description": "最后修改人姓名"
    },
    "update_date": {
      "description": "最后更新时间",
      "bsonType": "timestamp"
    }
  }
}
